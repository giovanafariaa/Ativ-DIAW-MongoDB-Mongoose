@base = http://localhost:3000
GET {{base}}/api/health

###
GET {{base}}/api/produtos

###
POST {{base}}/api/produtos
Content-Type: application/json

{"nome":"Cabo HDMI","preco":35,"categoria":"Acessórios","estoque":20}


### Vendas — substitua os IDs pelos de GET /api/produtos
POST {{base}}/api/vendas
Content-Type: application/json

{
  "cliente": { "nome": "Maria Silva", "email": "maria@email.com" },
  "itens": [
    { "produto": "6af21f27965661788339722a", "quantidade": 2 },
    { "produto": "6af21f279656617883397229", "quantidade": 1 }
  ]
}

###
GET {{base}}/api/vendas

###
GET {{base}}/api/vendas?cliente=maria&de=2025-01-01

###
GET {{base}}/api/vendas/COLE_O_ID_DA_VENDA

### Alterar preço de um produto (vendas antigas não mudam)
PUT {{base}}/api/produtos/COLE_O_ID_DO_PRODUTO_1
Content-Type: application/json

{ "preco": 9999 }

###
GET {{base}}/api/relatorios/vendas

###
GET {{base}}/api/relatorios/vendas?limite=3
